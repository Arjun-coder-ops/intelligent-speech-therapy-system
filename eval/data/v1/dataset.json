{
  "version": "1.0.0",
  "description": "Standardized evaluation dataset for Speech Therapy Assessment and Practice Recommendation pipelines.",
  "metadata": {
    "sampling_rate": 16000,
    "channels": 1,
    "format": "PCM_16"
  },
  "speech_evaluation_samples": [
    {
      "id": "eval_speech_01",
      "reference_text": "think",
      "audio_path": "eval/data/v1/audio/word_think.wav",
      "target_phonemes": ["TH", "IH", "NG", "K"],
      "category": "fricatives_unvoiced"
    },
    {
      "id": "eval_speech_02",
      "reference_text": "see",
      "audio_path": "eval/data/v1/audio/word_see.wav",
