    },
    {
      "id": "eval_speech_04",
      "reference_text": "red",
      "audio_path": "eval/data/v1/audio/word_red.wav",
      "target_phonemes": ["R", "EH", "D"],
      "category": "liquid_consonant"
    },
    {
      "id": "eval_speech_05",
      "reference_text": "run",
      "audio_path": "eval/data/v1/audio/word_run.wav",
      "target_phonemes": ["R", "AH", "N"],
      "category": "liquid_consonant"
    },
    {
      "id": "eval_speech_06",
      "reference_text": "zoo",
