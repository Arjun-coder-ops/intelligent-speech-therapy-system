# Database Configuration (PostgreSQL or leave blank for local SQLite fallback)
POSTGRESQL_URI=postgresql://postgres:password@localhost:5432/speech_therapy_db

# Security Keys (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_SECRET_KEY=change-this-jwt-secret-in-production-to-a-secure-random-string

# AI / LLM Configuration (OpenRouter API key for practice sentence generation)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: CORS allowed frontend origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: Upload folder location (defaults to ./uploads)
UPLOAD_FOLDER=uploads

# Flask Environment
FLASK_ENV=development